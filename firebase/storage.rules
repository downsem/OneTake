rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function friendshipIdA(uidA, uidB) {
      return uidA + '_' + uidB;
    }

    function friendshipIdB(uidA, uidB) {
      return uidB + '_' + uidA;
    }

    function hasFriendship(uidA, uidB) {
      return signedIn() && uidA != uidB && (
        firestore.exists(/databases/(default)/documents/friendships/$(friendshipIdA(uidA, uidB))) ||
        firestore.exists(/databases/(default)/documents/friendships/$(friendshipIdB(uidA, uidB)))
      );
    }

    match /responses/{userId}/{fileName} {
      allow read: if isSelf(userId) || isAdmin() || hasFriendship(request.auth.uid, userId);
      allow create, update: if isSelf(userId) && request.resource.size < 75 * 1024 * 1024;
      allow delete: if isSelf(userId) || isAdmin();
    }
  }
}
